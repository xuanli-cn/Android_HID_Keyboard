<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mouse_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:keepScreenOn="true"
    android:splitMotionEvents="true"
    tools:context=".Mouse">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/BtnBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/BtnBackText" />

        <Button
            android:id="@+id/toggle_shortcuts"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/show_shortcuts" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:labelFor="@id/sbMouseMoveSpeed"
            android:text="@string/tvMoveSpeed"
            android:textColor="@color/white" />

        <SeekBar
            android:id="@+id/sbMouseMoveSpeed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:min="1"
            android:max="6"
            android:progress="3" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/shortcuts"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button android:id="@+id/mBtn1" style="@style/DefaultButton"
            android:tag="@string/KeyCode80" android:text="@string/KeyText80" />
        <Button android:id="@+id/mBtn2" style="@style/DefaultButton"
            android:tag="@string/KeyCode84" android:text="@string/KeyText84" />
        <Button android:id="@+id/mBtn3" style="@style/DefaultButton"
            android:tag="@string/KeyCode83" android:text="@string/KeyText83" />
        <Button android:id="@+id/mBtn4" style="@style/DefaultButton"
            android:tag="@string/KeyCode85" android:text="@string/KeyText85" />
        <Button android:id="@+id/mBtn5" style="@style/DefaultButton"
            android:tag="@string/KeyCode86" android:text="@string/KeyText86" />
        <Button android:id="@+id/mBtn6" style="@style/DefaultButton"
            android:tag="@string/KeyCode87" android:text="@string/KeyText87" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/touch_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="8dp"
        android:background="@drawable/touch_area_border"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/touch_area">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/touchpad_hint"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <Button android:id="@+id/mouse_left" style="@style/DefaultButton"
            android:tag="@string/MouseLeftKeyCode" android:text="@string/MouseLeftKey" />
        <Button android:id="@+id/mouse_middle" style="@style/DefaultButton"
            android:tag="@string/MouseMiddleKeyCode" android:text="@string/MouseMiddleKey" />
        <Button android:id="@+id/mouse_right" style="@style/DefaultButton"
            android:tag="@string/MouseRightKeyCode" android:text="@string/MouseRightKey" />
    </LinearLayout>
</LinearLayout>
